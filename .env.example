# Copy to .env and supply distinct development passwords. This file is not loaded automatically.
POSTGRES_PASSWORD=replace-with-a-local-migration-password
CORTEX_APP_PASSWORD=replace-with-a-local-application-password
CORTEX_MIGRATION_DATABASE_URL=postgresql+pg8000://cortex_migrator:replace-with-a-local-migration-password@127.0.0.1:55432/cortex_test
CORTEX_TEST_ADMIN_URL=postgresql+pg8000://cortex_migrator:replace-with-a-local-migration-password@127.0.0.1:55432/cortex_test
CORTEX_TEST_DATABASE_URL=postgresql+pg8000://cortex_app:replace-with-a-local-application-password@127.0.0.1:55432/cortex_test
CORTEX_DATABASE_URL=postgresql+pg8000://cortex_app:replace-with-a-local-application-password@127.0.0.1:55432/cortex_test
CORTEX_JWT_ISSUER=https://your-identity-provider.example/realms/cortex
CORTEX_JWT_AUDIENCE=cortex-core
# Configure exactly one: an HTTPS JWKS URL, or a local RS256 public-key file.
CORTEX_JWKS_URL=https://your-identity-provider.example/realms/cortex/protocol/openid-connect/certs
# CORTEX_JWT_PUBLIC_KEY_FILE=/absolute/private/path/public.pem
