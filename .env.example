# Copy to .env and supply distinct development passwords. This file is not loaded automatically.
POSTGRES_PASSWORD=replace-with-a-local-migration-password
CORTEX_APP_PASSWORD=replace-with-a-local-application-password
CORTEX_MIGRATION_DATABASE_URL=postgresql+pg8000://cortex_migrator:replace-with-a-local-migration-password@127.0.0.1:55432/cortex_test
CORTEX_TEST_ADMIN_URL=postgresql+pg8000://cortex_migrator:replace-with-a-local-migration-password@127.0.0.1:55432/cortex_test
CORTEX_TEST_DATABASE_URL=postgresql+pg8000://cortex_app:replace-with-a-local-application-password@127.0.0.1:55432/cortex_test
CORTEX_DATABASE_URL=postgresql+pg8000://cortex_app:replace-with-a-local-application-password@127.0.0.1:55432/cortex_test
CORTEX_JWT_ISSUER=https://your-identity-provider.example/realms/cortex
CORTEX_JWT_AUDIENCE=cortex-core
# Configure exactly one: an HTTPS JWKS URL, or a local RS256 public-key file.
CORTEX_JWKS_URL=https://your-identity-provider.example/realms/cortex/protocol/openid-connect/certs
# CORTEX_JWT_PUBLIC_KEY_FILE=/absolute/private/path/public.pem

# OpenRouter: server-side only. Both key and model are required to enable extraction.
CORTEX_MODEL_PROVIDER=openrouter
# CORTEX_OPENROUTER_API_KEY=replace-with-your-private-key
CORTEX_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_API_KEY is also accepted. Never expose either key to the frontend.

# Optional local alternative: select an already installed model explicitly.
# CORTEX_MODEL_PROVIDER=ollama
# CORTEX_LOCAL_MODEL=qwen2.5vl:7b
# CORTEX_OLLAMA_URL=http://127.0.0.1:11434

# Trusted-host HTTP/MCP confirmation verification; the private signing key stays outside the model/backend.
# CORTEX_CONFIRMATION_PUBLIC_KEY_FILE=/absolute/private/path/confirmation-public.pem

# Optional HTTPS MCP resource discovery. The external issuer must issue tokens for this exact audience.
# CORTEX_MCP_PUBLIC_URL=https://cortex.example.com/mcp/
# CORTEX_JWT_AUDIENCE=https://cortex.example.com/mcp/
# The metadata route advertises CORTEX_JWT_ISSUER; login/registration remain with that issuer.

# Shared per-domain UTC-day reservation cap; configure consistently across application instances.
CORTEX_MODEL_DAILY_ATTEMPT_LIMIT=100

# Sensitive direct HTTP operations require the same signed confirmation as MCP.
CORTEX_HTTP_CONFIRMATION_MODE=required
# trusted_host is an explicit compatibility mode for a controlled backend host only.

# Exact browser origins; JSON array, no trailing slash or wildcard. Empty disables CORS.
CORTEX_CORS_ORIGINS=[]
# Development example: ["http://localhost:5173"]
# Production example: ["https://app.example.com"]

# Explicit opt-in for personal backend synthesis via configured OpenRouter.
CORTEX_SYNTHESIS_ENABLED=false
