{
  "schemas": {
    "GraphPublicationRetryInput": {
      "type": "object",
      "properties": {
        "expected_published_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        },
        "expected_attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775806
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Motif explicite, non vide après retrait des espaces périphériques."
        }
      },
      "required": [
        "expected_published_version",
        "expected_attempt_id",
        "expected_generation",
        "idempotency_key",
        "reason"
      ],
      "additionalProperties": false
    },
    "GraphPublicationAttempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "predecessor_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "active": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "preparing",
            "uncertain",
            "ready",
            "stale",
            "superseded"
          ]
        },
        "base_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "generation",
        "predecessor_id",
        "subject",
        "reason",
        "created_at",
        "active",
        "status",
        "base_version",
