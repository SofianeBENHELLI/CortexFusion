        "openWorldHint": false
      }
    },
    {
      "name": "proposal_diff",
      "description": "Read an authorized proposal's changes and stale-base indicator before preparing a human decision.",
      "inputSchema": {
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "proposal_id": {
            "format": "uuid",
            "title": "Proposal Id",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
