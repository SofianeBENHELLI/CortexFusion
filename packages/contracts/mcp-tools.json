{
  "tools": [
    {
      "name": "query",
      "description": "Return exact approved excerpts with source citations; no model synthesis.",
      "inputSchema": {
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "max_chars": {
            "default": 8000,
            "title": "Max Chars",
            "type": "integer"
          }
        },
        "required": [
          "domain_id",
          "question"
        ],
        "title": "queryArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "inspect_concept",
      "description": "Inspect a concept and only its authorized relationships.",
      "inputSchema": {
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "concept_id": {
            "format": "uuid",
            "title": "Concept Id",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "concept_id"
        ],
        "title": "inspect_conceptArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "propose",
      "description": "Submit a source-backed proposal; this cannot change trusted knowledge.",
      "inputSchema": {
        "$defs": {
          "Concept": {
            "additionalProperties": false,
            "properties": {
              "concept_id": {
                "format": "uuid",
                "title": "Concept Id",
                "type": "string"
              },
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "body": {
                "maxLength": 30000,
                "minLength": 1,
                "title": "Body",
                "type": "string"
              },
              "maturity": {
                "$ref": "#/$defs/Maturity",
                "default": "emerging"
              },
              "sources": {
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "maxItems": 30,
                "minItems": 1,
                "title": "Sources",
                "type": "array"
              },
              "links": {
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "maxItems": 100,
                "title": "Links",
                "type": "array"
              }
            },
            "required": [
              "concept_id",
              "title",
              "body",
              "sources"
            ],
            "title": "Concept",
            "type": "object"
          },
          "Link": {
            "additionalProperties": false,
            "properties": {
              "target_id": {
                "format": "uuid",
                "title": "Target Id",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "structural",
                  "associative"
                ],
                "title": "Kind",
                "type": "string"
              },
              "primary": {
                "default": false,
                "title": "Primary",
                "type": "boolean"
              },
              "weight": {
                "default": 1.0,
                "maximum": 1,
                "minimum": 0,
                "title": "Weight",
                "type": "number"
              }
            },
            "required": [
              "target_id",
              "kind"
            ],
            "title": "Link",
            "type": "object"
          },
          "Maturity": {
            "enum": [
              "emerging",
              "observed",
              "established",
              "reference"
            ],
            "title": "Maturity",
            "type": "string"
          },
          "ProposalInput": {
            "additionalProperties": false,
            "properties": {
              "base_version": {
                "minimum": 0,
                "title": "Base Version",
                "type": "integer"
              },
              "changes": {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "put_concept": "#/$defs/PutConcept",
                      "retire_concept": "#/$defs/RetireConcept"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/PutConcept"
                    },
                    {
                      "$ref": "#/$defs/RetireConcept"
                    }
                  ]
                },
                "maxItems": 50,
                "minItems": 1,
                "title": "Changes",
                "type": "array"
              },
              "reason": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Reason",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 8,
                "title": "Idempotency Key",
                "type": "string"
              }
            },
            "required": [
              "base_version",
              "changes",
              "reason",
              "idempotency_key"
            ],
            "title": "ProposalInput",
            "type": "object"
          },
          "PutConcept": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "put_concept",
                "default": "put_concept",
                "title": "Kind",
                "type": "string"
              },
              "concept": {
                "$ref": "#/$defs/Concept"
              }
            },
            "required": [
              "concept"
            ],
            "title": "PutConcept",
            "type": "object"
          },
          "RetireConcept": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "retire_concept",
                "default": "retire_concept",
                "title": "Kind",
                "type": "string"
              },
              "concept_id": {
                "format": "uuid",
                "title": "Concept Id",
                "type": "string"
              }
            },
            "required": [
              "concept_id"
            ],
            "title": "RetireConcept",
            "type": "object"
          },
          "SourceRef": {
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "format": "uuid",
                "title": "Source Id",
                "type": "string"
              },
              "start": {
                "description": "Zero-based Unicode code point offset, inclusive",
                "minimum": 0,
                "title": "Start",
                "type": "integer"
              },
              "end": {
                "description": "Unicode code point offset, exclusive; not UTF-16 units",
                "exclusiveMinimum": 0,
                "title": "End",
                "type": "integer"
              }
            },
            "required": [
              "source_id",
              "start",
              "end"
            ],
            "title": "SourceRef",
            "type": "object"
          }
        },
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "proposal": {
            "$ref": "#/$defs/ProposalInput"
          }
        },
        "required": [
          "domain_id",
          "proposal"
        ],
        "title": "proposeArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "feedback",
      "description": "Append feedback on your own authorized episode without rewriting knowledge.",
      "inputSchema": {
        "$defs": {
          "FeedbackInput": {
            "additionalProperties": false,
            "properties": {
              "rating": {
                "enum": [
                  "helpful",
                  "unhelpful"
                ],
                "title": "Rating",
                "type": "string"
              },
              "explanation": {
                "default": "",
                "maxLength": 2000,
                "title": "Explanation",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 8,
                "title": "Idempotency Key",
                "type": "string"
              }
            },
            "required": [
              "rating",
              "idempotency_key"
            ],
            "title": "FeedbackInput",
            "type": "object"
          }
        },
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "episode_id": {
            "format": "uuid",
            "title": "Episode Id",
            "type": "string"
          },
          "feedback": {
            "$ref": "#/$defs/FeedbackInput"
          }
        },
        "required": [
          "domain_id",
          "episode_id",
          "feedback"
        ],
        "title": "feedbackArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "describe_actions",
      "description": "Discover HTTP interaction contracts and human decision policies. Metadata does not grant access.",
      "inputSchema": {
        "properties": {},
        "title": "describe_actionsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "my_workspace",
      "description": "Discover this authenticated subject's domains and capabilities; never invent identity or roles.",
      "inputSchema": {
        "properties": {},
        "title": "my_workspaceArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
