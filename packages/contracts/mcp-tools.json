    {
      "name": "list_conversations",
      "description": "Find the caller's personal conversations. Domain owners cannot inspect other users' conversations.",
      "inputSchema": {
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "after": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "After"
          },
          "archived": {
            "default": false,
            "title": "Archived",
            "type": "boolean"
          }
        },
        "required": [
          "domain_id"
        ],
        "title": "list_conversationsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "create_conversation",
      "description": "Create a personal conversation after user intent. Reuse the same idempotency key for retries.",
      "inputSchema": {
        "$defs": {
          "ConversationInput": {
            "additionalProperties": false,
            "properties": {
              "title": {
                "default": "Nouvelle conversation",
                "maxLength": 200,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 8,
                "title": "Idempotency Key",
                "type": "string"
              }
            },
            "required": [
              "idempotency_key"
            ],
            "title": "ConversationInput",
            "type": "object"
          }
        },
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "conversation": {
            "$ref": "#/$defs/ConversationInput"
          }
        },
        "required": [
          "domain_id",
          "conversation"
        ],
        "title": "create_conversationArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "conversation_query",
      "description": "Answer with approved excerpts and record a personal message. Reuse retry keys. Follow-ups remain independent lexical queries.",
      "inputSchema": {
        "$defs": {
          "ConversationQueryInput": {
            "additionalProperties": false,
            "properties": {
              "question": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Question",
                "type": "string"
              },
              "max_chars": {
                "default": 8000,
                "maximum": 20000,
                "minimum": 100,
                "title": "Max Chars",
                "type": "integer"
              },
              "limit": {
                "default": 5,
                "maximum": 10,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 8,
                "title": "Idempotency Key",
                "type": "string"
              }
            },
            "required": [
              "question",
              "idempotency_key"
            ],
            "title": "ConversationQueryInput",
            "type": "object"
          }
        },
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "question": {
            "$ref": "#/$defs/ConversationQueryInput"
          }
        },
        "required": [
          "domain_id",
          "conversation_id",
          "question"
        ],
        "title": "conversation_queryArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "conversation_messages",
      "description": "Read the caller's authorized conversation messages in sequence order.",
      "inputSchema": {
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "after": {
            "default": 0,
            "minimum": 0,
            "title": "After",
            "type": "integer"
          }
        },
        "required": [
          "domain_id",
          "conversation_id"
        ],
        "title": "conversation_messagesArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_issues",
      "description": "List personal knowledge gaps or disputed answers with their current decision revisions.",
      "inputSchema": {
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "after": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "After"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "open",
                  "in_progress",
                  "resolved",
                  "dismissed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          }
        },
        "required": [
          "domain_id"
        ],
        "title": "list_issuesArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "decide_issue",
      "description": "Apply the user's explicit decision to their own issue. Refresh stale revisions; resolution does not fix or certify knowledge.",
      "inputSchema": {
        "$defs": {
          "IssueDecisionInput": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "start",
                  "resolve",
                  "dismiss",
                  "reopen"
                ],
                "title": "Action",
                "type": "string"
              },
              "expected_revision": {
                "minimum": 0,
                "title": "Expected Revision",
                "type": "integer"
              },
              "reason": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Reason",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 8,
                "title": "Idempotency Key",
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "reason",
              "idempotency_key"
            ],
            "title": "IssueDecisionInput",
            "type": "object"
          }
        },
        "properties": {
          "domain_id": {
            "format": "uuid",
            "title": "Domain Id",
            "type": "string"
          },
          "issue_id": {
            "format": "uuid",
            "title": "Issue Id",
            "type": "string"
          },
          "decision": {
            "$ref": "#/$defs/IssueDecisionInput"
          }
        },
        "required": [
          "domain_id",
          "issue_id",
          "decision"
        ],
        "title": "decide_issueArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
