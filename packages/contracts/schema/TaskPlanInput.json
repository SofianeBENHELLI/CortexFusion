{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPlanInput",
  "type": "object",
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "expected_revision",
    "priority",
    "due_at",
    "reason",
    "idempotency_key"
  ],
  "additionalProperties": false
}
