{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceAccessEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_source": {
      "type": "string",
      "enum": [
        "runtime_context",
        "unattributed"
      ]
    },
    "previous_allowed_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "allowed_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "actor",
    "actor_source",
    "previous_allowed_subjects",
    "allowed_subjects",
    "created_at"
  ]
}
