{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMissionEvidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_hash": {
      "type": "string",
      "maxLength": 64
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "total_characters": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "excerpt": {
      "type": "string",
      "maxLength": 8192
    },
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "mission_revision": {
      "type": "integer",
      "minimum": 1
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "read_kind": {
      "type": "string",
      "enum": [
        "human_report_review"
      ]
    }
  },
  "required": [
    "source_id",
    "source_hash",
    "title",
    "location",
    "start",
    "end",
    "total_characters",
    "excerpt",
    "mission_id",
    "mission_revision",
    "index",
    "read_kind"
  ]
}
