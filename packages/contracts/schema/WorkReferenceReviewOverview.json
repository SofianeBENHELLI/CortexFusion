{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkReferenceReviewOverview",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/WorkReferenceReviewSummary"
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "sort": {
      "type": "string",
      "const": "created_at_asc_id_asc"
    }
  },
  "required": [
    "total",
    "items",
    "has_more",
    "sort"
  ],
  "additionalProperties": false,
  "$defs": {
    "WorkReferenceReviewSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_review",
            "changes_requested",
            "ready_for_owner"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "status",
        "created_at",
        "question",
        "author",
        "reviewer",
        "updated_at",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
