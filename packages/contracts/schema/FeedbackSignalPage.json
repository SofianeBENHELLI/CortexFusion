{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FeedbackSignalInput": {
      "additionalProperties": false,
      "properties": {
        "companion_response_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Companion Response Id"
        },
        "origin": {
          "enum": [
            "explicit",
            "observed",
            "inferred"
          ],
          "title": "Origin",
          "type": "string"
        },
        "kind": {
          "enum": [
            "thumbs_up",
            "thumbs_down",
            "comment",
            "reformulation",
            "correction",
            "abandon",
            "resolved",
            "satisfaction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 2000,
          "title": "Comment",
          "type": "string"
        },
        "companion": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Companion",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "sentiment": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentiment"
        },
        "iteration_index": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iteration Index"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "kind",
        "companion",
        "idempotency_key"
      ],
      "title": "FeedbackSignalInput",
      "type": "object"
    },
    "FeedbackSignalView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "served_version": {
          "title": "Served Version",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "signal": {
          "$ref": "#/$defs/FeedbackSignalInput"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "episode_id",
        "served_version",
        "source_ids",
        "signal",
        "created_at"
      ],
      "title": "FeedbackSignalView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/FeedbackSignalView"
      },
      "title": "Items",
      "type": "array"
    },
    "next_after": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next After"
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "title": "FeedbackSignalPage",
  "type": "object"
}
