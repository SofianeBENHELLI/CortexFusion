{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedCasePreparation",
  "type": "object",
  "properties": {
    "preparation_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "permissions_version": {
      "type": "integer",
      "minimum": 0
    },
    "policy_version": {
      "type": "string",
      "enum": [
        "named-excerpt-v1"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "explicit",
        "observed",
        "inferred"
      ]
    }
  },
  "required": [
    "preparation_id",
    "content_hash",
    "expires_at",
    "permissions_version",
    "policy_version",
    "origin"
  ],
  "additionalProperties": false
}
