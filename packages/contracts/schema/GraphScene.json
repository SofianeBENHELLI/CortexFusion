{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphScene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_id",
    "at_version",
    "visibility",
    "totals",
    "bounds",
    "glyphs",
    "links",
    "view",
    "cell_size",
    "routes_total",
    "coverage"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "format": "uuid"
    },
    "at_version": {
      "type": "integer",
      "minimum": 0
    },
    "visibility": {
      "type": "string"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concepts",
        "relations",
        "references"
      ],
      "properties": {
        "concepts": {
          "type": "integer",
          "minimum": 0
        },
        "relations": {
          "type": "integer",
          "minimum": 0
        },
        "references": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bounds": {
      "$ref": "#/$defs/MapBounds"
    },
    "glyphs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/MapGlyph"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "count",
          "weight",
          "aggregate"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "weight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "aggregate": {
            "type": "boolean"
          }
        }
      }
    },
    "view": {
      "$ref": "#/$defs/MapBounds"
    },
    "cell_size": {
      "type": "number"
    },
    "routes_total": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "const": "viewport",
      "type": "string"
    }
  },
  "$defs": {
    "MapBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "MapGlyph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "concept_id",
        "title",
        "x",
        "y",
        "count",
        "bounds",
        "degree"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "concept_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "$ref": "#/$defs/MapBounds"
        },
        "degree": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
