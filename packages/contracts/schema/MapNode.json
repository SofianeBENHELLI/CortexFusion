{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "maturity",
    "group",
    "territory",
    "x",
    "y",
    "degree"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "maturity": {
      "type": "string"
    },
    "group": {
      "type": "string"
    },
    "territory": {
      "type": "string"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "degree": {
      "type": "integer",
      "minimum": 0
    }
  }
}
