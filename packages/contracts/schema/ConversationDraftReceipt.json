{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationDraftReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "draft_key": {
      "type": "string"
    },
    "revision": {
