{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMissionCreate",
  "type": "object",
  "properties": {
    "mandate": {
      "$ref": "#/$defs/AgentMissionMandate"
    },
    "preparation_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "mandate",
    "preparation_id",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "$defs": {
    "AgentMissionMandate": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "maxLength": 4000
        },
        "criteria": {
          "type": "string",
          "maxLength": 4000
        },
        "agent": {
          "type": "string",
          "maxLength": 200
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_hash": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "max_reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "objective",
        "criteria",
        "agent",
        "source_id",
        "source_hash",
        "max_reads",
        "max_chars",
        "expires_at"
      ],
      "additionalProperties": false
    }
  }
}
