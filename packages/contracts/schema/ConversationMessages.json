{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "location",
        "content_hash",
        "start",
        "end",
        "excerpt"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "maturity": {
          "$ref": "#/$defs/Maturity",
          "default": "emerging"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "maxItems": 100,
          "title": "Links",
          "type": "array"
        }
      },
      "required": [
        "concept_id",
        "title",
        "body",
        "sources"
      ],
      "title": "Concept",
      "type": "object"
    },
    "ContextPassage": {
      "additionalProperties": false,
      "description": "Read-only excerpt of a published concept, never a replacement Concept.",
      "properties": {
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "maturity": {
          "$ref": "#/$defs/Maturity"
        },
        "body_start": {
          "description": "Inclusive Unicode offset in the published body",
          "minimum": 0,
          "title": "Body Start",
          "type": "integer"
        },
        "body_end": {
          "description": "Exclusive Unicode offset in the published body",
          "exclusiveMinimum": 0,
          "title": "Body End",
          "type": "integer"
        },
        "body_total_chars": {
          "exclusiveMinimum": 0,
          "title": "Body Total Chars",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "concept_id",
        "title",
        "maturity",
        "body_start",
        "body_end",
        "body_total_chars",
        "text",
        "sources"
      ],
      "title": "ContextPassage",
      "type": "object"
    },
    "ConversationMessage": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/QueryResult"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "question",
        "result",
        "created_at"
      ],
      "title": "ConversationMessage",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "structural",
            "associative"
          ],
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "kind"
      ],
      "title": "Link",
      "type": "object"
    },
    "Maturity": {
      "enum": [
        "emerging",
        "observed",
        "established",
        "reference"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "QueryResult": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "status": {
          "enum": [
            "evidence_found",
            "knowledge_gap",
            "context_limited"
          ],
          "title": "Status",
          "type": "string"
        },
        "mode": {
          "const": "extractive",
          "default": "extractive",
          "title": "Mode",
          "type": "string"
        },
        "served_version": {
          "title": "Served Version",
          "type": "integer"
        },
        "concepts": {
          "description": "Complete selected concepts only; long selections are in context_passages. Read the concept endpoint for the full published body.",
          "items": {
            "$ref": "#/$defs/Concept"
          },
          "title": "Concepts",
          "type": "array"
        },
        "context_passages": {
          "description": "Bounded, source-backed context selections; empty for legacy episodes. Unicode text lengths plus answer separators fit max_chars.",
          "items": {
            "$ref": "#/$defs/ContextPassage"
          },
          "title": "Context Passages",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "processing": {
          "const": "local_no_model",
          "default": "local_no_model",
          "title": "Processing",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "answer",
        "status",
        "served_version",
        "concepts",
        "citations"
      ],
      "title": "QueryResult",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Zero-based Unicode code point offset, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Unicode code point offset, exclusive; not UTF-16 units",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start",
        "end"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ConversationMessage"
      },
      "title": "Items",
      "type": "array"
    },
    "next_after": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next After"
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "title": "ConversationMessages",
  "type": "object"
}
