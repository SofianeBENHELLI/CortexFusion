{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceDraftInput",
  "type": "object",
  "properties": {
    "content": {
      "$ref": "#/$defs/ReferenceDraftContent"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "content",
    "expected_revision",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "$defs": {
    "ReferenceDraftContent": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "criteria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "selection": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740990
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "theme",
        "question",
        "criteria",
        "source_id",
        "source_hash",
        "excerpt",
        "selection"
      ],
      "additionalProperties": false
    }
  }
}
