{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceReviewSelection",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "format": "uuid"
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "question_id",
    "draft_revision",
    "reviewer"
  ],
  "additionalProperties": false
}
