{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceDraftPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/ReferenceDraftSummary"
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "additionalProperties": false,
  "$defs": {
    "ReferenceDraftSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "theme",
        "question",
        "revision",
        "updated_at"
      ],
      "additionalProperties": false
    }
  }
}
