{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkActivityReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "reference_review",
        "mission",
        "shared_case"
      ]
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "kind",
    "event_id",
    "read_at"
  ]
}
