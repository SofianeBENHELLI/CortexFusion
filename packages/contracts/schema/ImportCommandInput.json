{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportCommandInput",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "process",
        "retry",
        "cancel"
      ]
    },
    "expected_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "action",
    "expected_digest",
    "idempotency_key",
    "limit"
  ],
  "additionalProperties": false
}
