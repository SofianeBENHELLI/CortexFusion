{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkImportOverview",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/WorkImportSummary"
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "sort": {
      "type": "string",
      "const": "failed_first_created_at_asc_id_asc"
    },
    "pending_jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failed_jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "total",
    "items",
    "has_more",
    "sort",
    "pending_jobs",
    "failed_jobs"
  ],
  "additionalProperties": false,
  "$defs": {
    "WorkImportSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "collection_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "collection_id",
        "collection_name",
        "pending",
        "failed",
        "created_at"
      ],
      "additionalProperties": false
    }
  }
}
