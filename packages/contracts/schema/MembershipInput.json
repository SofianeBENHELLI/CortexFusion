{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "subject": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "enum": [
            "owner",
            "corpus_manager",
            "contributor",
            "agent",
            "viewer"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Role"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "subject",
    "role",
    "reason",
    "idempotency_key"
  ],
  "title": "MembershipInput",
  "type": "object"
}
