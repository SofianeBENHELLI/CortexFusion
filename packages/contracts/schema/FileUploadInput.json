{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "filename": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[^/\\\\\\x00-\\x1f]+$",
      "title": "Filename",
      "type": "string"
    },
    "content_base64": {
      "maxLength": 666668,
      "minLength": 1,
      "title": "Content Base64",
      "type": "string"
    },
    "allowed_subjects": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Allowed Subjects",
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "filename",
    "content_base64",
    "allowed_subjects",
    "idempotency_key"
  ],
  "title": "FileUploadInput",
  "type": "object"
}
