{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "processing_destination": {
      "enum": [
        "ollama",
        "openrouter"
      ],
      "title": "Processing Destination",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "processing_destination",
    "idempotency_key"
  ],
  "title": "ExtractionInput",
  "type": "object"
}
