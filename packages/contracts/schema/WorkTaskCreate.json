{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkTaskCreate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "criteria": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1
    },
    "due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "title",
    "instructions",
    "criteria",
    "idempotency_key"
  ],
  "additionalProperties": false
}
