{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContributionDraftContent",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "excerpt": {
      "type": "string",
      "maxLength": 200000
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "selection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source_id",
    "source_hash",
    "title",
    "excerpt",
    "reason",
    "selection"
  ],
  "additionalProperties": false
}
