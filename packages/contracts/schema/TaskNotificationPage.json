{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskNotificationPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/TaskNotification"
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "has_more": {
      "type": "boolean"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal"
      ]
    },
    "permissions_version": {
      "type": "integer",
      "minimum": 0
    },
    "work_version": {
      "type": "integer",
      "minimum": 0
    },
    "completeness": {
      "type": "string",
      "enum": [
        "partial",
        "complete"
      ]
    },
    "sort": {
      "type": "string",
      "enum": [
        "created_at_desc_id_desc"
      ]
    },
    "unread": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "items",
    "next_after",
    "has_more",
    "total",
    "as_of",
    "scope",
    "permissions_version",
    "work_version",
    "completeness",
    "sort",
    "unread"
  ],
  "additionalProperties": false,
  "$defs": {
    "TaskNotification": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "current_status": {
          "type": "string",
          "enum": [
            "unassigned",
            "offered",
            "in_progress",
            "blocked",
            "review",
            "completed",
            "cancelled"
          ]
        },
        "action": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "read_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "task_id",
        "title",
        "current_status",
        "action",
        "actor",
        "revision",
        "created_at",
        "read_at"
      ],
      "additionalProperties": false
    }
  }
}
