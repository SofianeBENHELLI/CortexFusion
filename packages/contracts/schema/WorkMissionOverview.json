{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkMissionOverview",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "waiting": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "claimed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expired": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reports": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "withheld": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/WorkMissionSummary"
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "sort": {
      "type": "string",
      "const": "expired_report_created_id"
    }
  },
  "required": [
    "total",
    "waiting",
    "claimed",
    "expired",
    "reports",
    "withheld",
    "items",
    "has_more",
    "sort"
  ],
  "additionalProperties": false,
  "$defs": {
    "WorkMissionSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "expired": {
          "type": "boolean"
        },
        "content_available": {
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "reads_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chars_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "id",
        "status",
        "revision",
        "created_at",
        "expires_at",
        "expired",
        "content_available",
        "title",
        "reads_used",
        "chars_used",
        "max_reads",
        "max_chars"
      ],
      "additionalProperties": false
    }
  }
}
