{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
      "title": "Request Id",
      "type": "string"
    },
    "cost_usd": {
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "cost_usd",
    "input_tokens",
    "output_tokens"
  ],
  "title": "SynthesisUsage",
  "type": "object"
}
