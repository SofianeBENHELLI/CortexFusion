{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProposalExpertReviewPage",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExpertReview"
      },
      "maxItems": 50
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "has_more": {
      "type": "boolean"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "permissions_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "work_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "proposal_digest": {
      "type": "string"
    },
    "proposal_review_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "proposal_id",
    "items",
    "total",
    "next_after",
    "has_more",
    "as_of",
    "permissions_version",
    "work_version",
    "proposal_digest",
    "proposal_review_revision"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExpertReview": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "author": {
          "type": "string"
        },
        "proposal_digest": {
          "type": "string"
        },
        "proposal_review_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "opinion": {
          "type": "string",
          "enum": [
            "supports",
            "changes_requested",
            "insufficient_evidence"
          ]
        },
        "justification": {
          "type": "string"
        },
        "evidence_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 20
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "validity": {
          "type": "string",
          "enum": [
            "current",
            "stale"
          ]
        }
      },
      "required": [
        "id",
        "task_id",
        "proposal_id",
        "author",
        "proposal_digest",
        "proposal_review_revision",
        "task_revision",
        "opinion",
        "justification",
        "evidence_source_ids",
        "created_at",
        "validity"
      ],
      "additionalProperties": false
    }
  }
}
