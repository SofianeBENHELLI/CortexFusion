{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseTaskReference",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "unassigned",
        "offered",
        "in_progress",
        "blocked",
        "review",
        "completed",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_id",
    "title",
    "status",
    "revision",
    "linked_at"
  ],
  "additionalProperties": false
}
