{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContributionDraftInput",
  "type": "object",
  "properties": {
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContributionDraftContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "content",
    "expected_revision",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "$defs": {
    "ContributionDraftContent": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "excerpt": {
          "type": "string",
          "maxLength": 200000
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "selection": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "source_hash",
        "title",
        "excerpt",
        "reason",
        "selection"
      ],
      "additionalProperties": false
    }
  }
}
