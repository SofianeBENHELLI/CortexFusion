{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "started",
      "default": "started",
      "title": "Event",
      "type": "string"
    },
    "protocol_version": {
      "const": "1",
      "default": "1",
      "title": "Protocol Version",
      "type": "string"
    },
    "operation_id": {
      "const": "conversations.query",
      "default": "conversations.query",
      "title": "Operation Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "idempotency_key"
  ],
  "title": "QueryStreamStarted",
  "type": "object"
}
