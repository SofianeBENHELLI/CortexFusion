{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMissionPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "agent": {
            "type": "string",
            "maxLength": 200
          },
          "max_reads": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "stopped",
              "completed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reads_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "chars_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "expired": {
            "type": "boolean"
          },
          "lease_expired": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "agent",
          "max_reads",
          "max_chars",
          "expires_at",
          "id",
          "author",
          "status",
          "revision",
          "reads_used",
          "chars_used",
          "expired",
          "lease_expired"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "next_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "additionalProperties": false
}
