{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskProposalReferences",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskProposalReference"
      },
      "maxItems": 20
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "max_links": {
      "const": 20,
      "type": "integer"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "can_link": {
      "type": "boolean"
    }
  },
  "required": [
    "task_id",
    "task_revision",
    "items",
    "total",
    "max_links",
    "as_of",
    "can_link"
  ],
  "additionalProperties": false,
  "$defs": {
    "TaskProposalReference": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "digest": {
          "type": "string"
        },
        "review_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string"
        },
        "linked_by": {
          "type": "string"
        },
        "linked_at": {
          "type": "string",
          "format": "date-time"
        },
        "can_review": {
          "type": "boolean"
        }
      },
      "required": [
        "proposal_id",
        "digest",
        "review_revision",
        "status",
        "linked_by",
        "linked_at",
        "can_review"
      ],
      "additionalProperties": false
    }
  }
}
