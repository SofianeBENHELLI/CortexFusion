{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedCaseEvents",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "audience": {
      "type": "string",
      "enum": [
        "declarant",
        "team"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "qualified",
              "closed_without_change",
              "withdrawn"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "action",
          "revision",
          "status",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "case_id",
    "audience",
    "items",
    "next_after",
    "total",
    "as_of"
  ],
  "additionalProperties": false
}
