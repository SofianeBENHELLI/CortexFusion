{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkCaseSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "qualified"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "created_at"
  ],
  "additionalProperties": false
}
