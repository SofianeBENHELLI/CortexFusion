{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CompanionResponseInput": {
      "additionalProperties": false,
      "properties": {
        "answer_text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Answer Text",
          "type": "string"
        },
        "answer_kind": {
          "enum": [
            "answer",
            "abstention",
            "clarification"
          ],
          "title": "Answer Kind",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 50,
          "title": "Citations",
          "type": "array"
        },
        "companion": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Companion",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "answer_text",
        "answer_kind",
        "companion",
        "idempotency_key"
      ],
      "title": "CompanionResponseInput",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Zero-based Unicode code point offset, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Unicode code point offset, exclusive; not UTF-16 units",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start",
        "end"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TimelineResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/CompanionResponseInput"
        },
        "reference_validation": {
          "enum": [
            "episode_references_checked",
            "no_references"
          ],
          "title": "Reference Validation",
          "type": "string"
        },
        "semantic_validation": {
          "const": "not_performed",
          "default": "not_performed",
          "title": "Semantic Validation",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "response",
        "reference_validation",
        "created_at"
      ],
      "title": "TimelineResponse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TimelineResponse"
      },
      "title": "Items",
      "type": "array"
    },
    "next_after": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next After"
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "title": "TimelineResponsePage",
  "type": "object"
}
