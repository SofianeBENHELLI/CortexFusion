{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapLink",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from",
    "to",
    "kind",
    "weight"
  ],
  "properties": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "reference",
        "structural",
        "associative"
      ]
    },
    "weight": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
