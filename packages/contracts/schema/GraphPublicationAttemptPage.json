{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphPublicationAttemptPage",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "published_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "active_attempt": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphPublicationAttempt"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GraphPublicationAttempt"
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "proposal_id",
    "target_version",
    "published_version",
    "active_attempt",
    "items",
    "next_after"
  ],
  "additionalProperties": false,
  "$defs": {
    "GraphPublicationAttempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "predecessor_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "active": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "preparing",
            "uncertain",
            "ready",
            "stale",
            "superseded"
          ]
        },
        "base_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "generation",
        "predecessor_id",
        "subject",
        "reason",
        "created_at",
        "active",
        "status",
        "base_version",
        "digest",
        "count"
      ],
      "additionalProperties": false
    }
  }
}
