{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "position": {
      "title": "Position",
      "type": "integer"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Id"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "attempts": {
      "title": "Attempts",
      "type": "integer"
    }
  },
  "required": [
    "position",
    "filename",
    "status",
    "source_id",
    "error_code",
    "attempts"
  ],
  "title": "ImportItemView",
  "type": "object"
}
