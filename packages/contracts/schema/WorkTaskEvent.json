{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkTaskEvent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "unassigned",
        "offered",
        "in_progress",
        "blocked",
        "review",
        "completed",
        "cancelled"
      ]
    },
    "assignee": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "result_summary": {
      "type": "string",
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "planning": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskPlanChange"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "task_id",
    "revision",
    "actor",
    "action",
    "previous_status",
    "status",
    "assignee",
    "reason",
    "result_summary",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "TaskPlanChange": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/TaskPlanState"
        },
        "after": {
          "$ref": "#/$defs/TaskPlanState"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "TaskPlanState": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "due_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "priority",
        "due_at"
      ],
      "additionalProperties": false
    }
  }
}
