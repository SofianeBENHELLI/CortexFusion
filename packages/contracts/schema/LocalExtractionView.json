{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "maturity": {
          "$ref": "#/$defs/Maturity",
          "default": "emerging"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "maxItems": 100,
          "title": "Links",
          "type": "array"
        }
      },
      "required": [
        "concept_id",
        "title",
        "body",
        "sources"
      ],
      "title": "Concept",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "structural",
            "associative"
          ],
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "kind"
      ],
      "title": "Link",
      "type": "object"
    },
    "Maturity": {
      "enum": [
        "emerging",
        "observed",
        "established",
        "reference"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "ProposalValidation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "passed",
          "title": "Status",
          "type": "string"
        },
        "source_support": {
          "const": "verbatim_v1",
          "title": "Source Support",
          "type": "string"
        },
        "graph": {
          "const": "acyclic",
          "title": "Graph",
          "type": "string"
        },
        "policy": {
          "const": "owner_low_risk_v1",
          "title": "Policy",
          "type": "string"
        },
        "risk": {
          "const": "low",
          "title": "Risk",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "source_support",
        "graph",
        "policy",
        "risk",
        "source_ids"
      ],
      "title": "ProposalValidation",
      "type": "object"
    },
    "ProposalView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "base_version": {
          "title": "Base Version",
          "type": "integer"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "approved",
            "published",
            "rejected",
            "deferred",
            "changes_requested",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ProposalValidation"
        },
        "payload": {
          "items": {
            "discriminator": {
              "mapping": {
                "put_concept": "#/$defs/PutConcept",
                "retire_concept": "#/$defs/RetireConcept"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PutConcept"
              },
              {
                "$ref": "#/$defs/RetireConcept"
              }
            ]
          },
          "title": "Payload",
          "type": "array"
        },
        "review_revision": {
          "title": "Review Revision",
          "type": "integer"
        },
        "replaces_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replaces Id"
        }
      },
      "required": [
        "id",
        "base_version",
        "digest",
        "reason",
        "status",
        "validation",
        "payload",
        "review_revision",
        "replaces_id"
      ],
      "title": "ProposalView",
      "type": "object"
    },
    "PutConcept": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "put_concept",
          "default": "put_concept",
          "title": "Kind",
          "type": "string"
        },
        "concept": {
          "$ref": "#/$defs/Concept"
        }
      },
      "required": [
        "concept"
      ],
      "title": "PutConcept",
      "type": "object"
    },
    "RetireConcept": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "retire_concept",
          "default": "retire_concept",
          "title": "Kind",
          "type": "string"
        },
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        }
      },
      "required": [
        "concept_id"
      ],
      "title": "RetireConcept",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Zero-based Unicode code point offset, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Unicode code point offset, exclusive; not UTF-16 units",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start",
        "end"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provider": {
      "default": "ollama",
      "enum": [
        "ollama",
        "openrouter"
      ],
      "title": "Provider",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "proposal": {
      "$ref": "#/$defs/ProposalView"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "model_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Digest"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Tokens"
    },
    "processing": {
      "default": "local_model_passage_selection",
      "enum": [
        "local_model_passage_selection",
        "openrouter_passage_selection"
      ],
      "title": "Processing",
      "type": "string"
    }
  },
  "required": [
    "id",
    "proposal",
    "model",
    "model_digest",
    "prompt_version",
    "input_tokens",
    "output_tokens"
  ],
  "title": "LocalExtractionView",
  "type": "object"
}
