{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationDraftInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
