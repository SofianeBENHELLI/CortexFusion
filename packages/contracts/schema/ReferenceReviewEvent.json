{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceReviewEvent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "action": {
      "type": "string",
      "enum": [
        "submit",
        "request_changes",
        "ready_for_owner",
        "withdraw"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_review",
        "changes_requested",
        "ready_for_owner",
        "withdrawn"
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "actor",
    "action",
    "revision",
    "status",
    "note",
    "created_at"
  ],
  "additionalProperties": false
}
