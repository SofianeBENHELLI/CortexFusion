{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "maturity": {
          "$ref": "#/$defs/Maturity",
          "default": "emerging"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "maxItems": 100,
          "title": "Links",
          "type": "array"
        }
      },
      "required": [
        "concept_id",
        "title",
        "body",
        "sources"
      ],
      "title": "Concept",
      "type": "object"
    },
    "ConceptDifference": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/Concept"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/Concept"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concept_id",
        "before",
        "after"
      ],
      "title": "ConceptDifference",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "structural",
            "associative"
          ],
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "kind"
      ],
      "title": "Link",
      "type": "object"
    },
    "Maturity": {
      "enum": [
        "emerging",
        "observed",
        "established",
        "reference"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Zero-based Unicode code point offset, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Unicode code point offset, exclusive; not UTF-16 units",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start",
        "end"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "base_version": {
      "title": "Base Version",
      "type": "integer"
    },
    "published_version": {
      "title": "Published Version",
      "type": "integer"
    },
    "comparison": {
      "enum": [
        "accepted_before_state",
        "current_published_state"
      ],
      "title": "Comparison",
      "type": "string"
    },
    "stale_base": {
      "title": "Stale Base",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ConceptDifference"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "proposal_id",
    "base_version",
    "published_version",
    "comparison",
    "stale_base",
    "items"
  ],
  "title": "ProposalDifference",
  "type": "object"
}
