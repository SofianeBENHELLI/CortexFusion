{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceReviewSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_review",
        "changes_requested",
        "ready_for_owner",
        "withdrawn"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "author",
    "reviewer",
    "draft_revision",
    "revision",
    "status",
    "updated_at",
    "question"
  ],
  "additionalProperties": false
}
