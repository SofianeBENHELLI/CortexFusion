{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkTaskReceipt",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "unassigned",
        "offered",
        "in_progress",
        "blocked",
        "review",
        "completed",
        "cancelled"
      ]
    }
  },
  "required": [
    "task_id",
    "event_id",
    "revision",
    "status"
  ],
  "additionalProperties": false
}
