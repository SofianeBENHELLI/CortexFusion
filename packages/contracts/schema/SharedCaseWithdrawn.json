{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedCaseWithdrawn",
  "type": "object",
  "properties": {
    "audience": {
      "type": "string",
      "enum": [
        "withdrawn"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "qualified",
        "closed_without_change",
        "withdrawn"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "withdraw",
          "qualify",
          "close_without_change",
          "reopen"
        ]
      }
    }
  },
  "required": [
    "audience",
    "id",
    "status",
    "revision",
    "created_at",
    "updated_at",
    "allowed_actions"
  ],
  "additionalProperties": false
}
