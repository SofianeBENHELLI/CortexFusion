{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapGlyph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "concept_id",
    "title",
    "x",
    "y",
    "count",
    "bounds",
    "degree"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "concept_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "bounds": {
      "$ref": "#/$defs/MapBounds"
    },
    "degree": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "MapBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    }
  }
}
