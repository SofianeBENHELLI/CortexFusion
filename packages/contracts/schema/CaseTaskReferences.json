{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseTaskReferences",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "audience": {
      "type": "string",
      "enum": [
        "declarant",
        "team"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaseTaskReference"
      },
      "maxItems": 20
    },
    "linked_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "max_links": {
      "type": "integer",
      "const": 20
    },
    "can_link": {
      "type": "boolean"
    },
    "can_unlink": {
      "type": "boolean"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "case_id",
    "case_revision",
    "audience",
    "items",
    "linked_count",
    "max_links",
    "can_link",
    "can_unlink",
    "as_of"
  ],
  "additionalProperties": false,
  "$defs": {
    "CaseTaskReference": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "unassigned",
            "offered",
            "in_progress",
            "blocked",
            "review",
            "completed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740990
        },
        "linked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "task_id",
        "title",
        "status",
        "revision",
        "linked_at"
      ],
      "additionalProperties": false
    }
  }
}
