{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphPublicationEventPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GraphPublicationEvent"
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "additionalProperties": false,
  "$defs": {
    "GraphPublicationEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "subject": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reserved",
            "uncertain",
            "ready",
            "stale",
            "superseded"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "attempt_id",
        "generation",
        "subject",
        "kind",
        "recorded_at"
      ],
      "additionalProperties": false
    }
  }
}
