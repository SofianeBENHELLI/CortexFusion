{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "location",
        "content_hash",
        "start",
        "end",
        "excerpt"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CompanionResponseInput": {
      "additionalProperties": false,
      "properties": {
        "answer_text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Answer Text",
          "type": "string"
        },
        "answer_kind": {
          "enum": [
            "answer",
            "abstention",
            "clarification"
          ],
          "title": "Answer Kind",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 50,
          "title": "Citations",
          "type": "array"
        },
        "companion": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Companion",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "answer_text",
        "answer_kind",
        "companion",
        "idempotency_key"
      ],
      "title": "CompanionResponseInput",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Zero-based Unicode code point offset, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Unicode code point offset, exclusive; not UTF-16 units",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start",
        "end"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "served_version": {
      "title": "Served Version",
      "type": "integer"
    },
    "response": {
      "$ref": "#/$defs/CompanionResponseInput"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "reference_validation": {
      "enum": [
        "episode_references_checked",
        "no_references"
      ],
      "title": "Reference Validation",
      "type": "string"
    },
    "semantic_validation": {
      "const": "not_performed",
      "default": "not_performed",
      "title": "Semantic Validation",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "episode_id",
    "served_version",
    "response",
    "citations",
    "reference_validation",
    "created_at"
  ],
  "title": "CompanionResponseView",
  "type": "object"
}
