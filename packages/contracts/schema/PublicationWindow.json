{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicationWindow",
  "type": "object",
  "properties": {
    "domain_id": {
      "type": "string",
      "format": "uuid"
    },
    "at_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "since": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/JournalPublication"
      }
    },
    "next_before": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "scan_limited": {
      "type": "boolean"
    }
  },
  "required": [
    "domain_id",
    "at_version",
    "since",
    "until",
    "items",
    "next_before",
    "scan_limited"
  ],
  "additionalProperties": false,
  "$defs": {
    "JournalPublication": {
      "properties": {
        "sequence": {
          "type": "integer",
          "title": "Sequence",
          "minimum": 1,
          "maximum": 9007199254740990
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid",
          "title": "Proposal Id"
        },
        "author": {
          "type": "string",
          "title": "Author"
        },
        "reason": {
          "type": "string",
          "title": "Reason"
        },
        "digest": {
          "type": "string",
          "title": "Digest"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Created At"
        },
        "published": {
          "type": "boolean",
          "title": "Published"
        },
        "publication": {
          "anyOf": [
            {
              "$ref": "#/$defs/JournalPublicationAudit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sequence",
        "proposal_id",
        "author",
        "reason",
        "digest",
        "created_at",
        "published",
        "publication"
      ],
      "title": "CommitSummary"
    },
    "JournalPublicationAudit": {
      "properties": {
        "publisher": {
          "type": "string",
          "title": "Publisher"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "title": "Recorded At"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "publisher",
        "recorded_at"
      ],
      "title": "PublicationAudit"
    }
  }
}
