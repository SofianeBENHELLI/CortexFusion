{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedCaseShare",
  "type": "object",
  "properties": {
    "preparation_id": {
      "type": "string",
      "format": "uuid"
    },
    "content": {
      "$ref": "#/$defs/SharedCaseContent"
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "preparation_id",
    "content",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "$defs": {
    "SharedCaseContent": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "target": {
          "type": "string",
          "enum": [
            "retrieved_evidence",
            "delivered_answer",
            "client_behavior"
          ]
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "policy_version": {
          "type": "string",
          "enum": [
            "named-excerpt-v1"
          ]
        },
        "personal_signal_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "excerpt",
        "target",
        "recipients",
        "policy_version"
      ],
      "additionalProperties": false
    }
  }
}
