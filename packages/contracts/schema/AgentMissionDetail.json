{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMissionDetail",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "maxLength": 4000
    },
    "criteria": {
      "type": "string",
      "maxLength": 4000
    },
    "agent": {
      "type": "string",
      "maxLength": 200
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_hash": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_reads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "stopped",
        "completed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reads_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "chars_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "expired": {
      "type": "boolean"
    },
    "lease_expired": {
      "type": "boolean"
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "report": {
      "type": "string",
      "maxLength": 8000
    },
    "hypotheses": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "claim",
          "renew",
          "read",
          "complete",
          "stop",
          "resume"
        ]
      },
      "maxItems": 6
    },
    "provider": {
      "type": "string",
      "const": "none"
    },
    "execution": {
      "type": "string",
      "const": "client_managed"
    }
  },
  "required": [
    "title",
    "objective",
    "criteria",
    "agent",
    "source_id",
    "source_hash",
    "max_reads",
    "max_chars",
    "expires_at",
    "id",
    "author",
    "status",
    "revision",
    "reads_used",
    "chars_used",
    "expired",
    "lease_expired",
    "lease_id",
    "lease_expires_at",
    "report",
    "hypotheses",
    "evidence",
    "created_at",
    "updated_at",
    "allowed_actions",
    "provider",
    "execution"
  ],
  "additionalProperties": false
}
