{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMissionCommand",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "claim",
        "renew",
        "stop",
        "resume"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "lease_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "action",
    "expected_revision",
    "idempotency_key"
  ],
  "additionalProperties": false
}
