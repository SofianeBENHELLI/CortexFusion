{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SynthesisUsage": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Request Id",
          "type": "string"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "cost_usd",
        "input_tokens",
        "output_tokens"
      ],
      "title": "SynthesisUsage",
      "type": "object"
    },
    "SynthesisView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openrouter",
            "none"
          ],
          "title": "Provider",
          "type": "string"
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested Model"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "budget_reserved": {
          "title": "Budget Reserved",
          "type": "boolean"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "status": {
          "enum": [
            "unresolved",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "response_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/SynthesisUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        }
      },
      "required": [
        "id",
        "episode_id",
        "provider",
        "requested_model",
        "prompt_version",
        "budget_reserved",
        "idempotency_key",
        "created_at",
        "status",
        "response_id",
        "error_code",
        "usage",
        "finished_at"
      ],
      "title": "SynthesisView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/SynthesisView"
      },
      "title": "Items",
      "type": "array"
    },
    "next_after": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next After"
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "title": "SynthesisPage",
  "type": "object"
}
