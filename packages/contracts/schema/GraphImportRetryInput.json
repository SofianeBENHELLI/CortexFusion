{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphImportRetryInput",
  "type": "object",
  "properties": {
    "expected_published_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "expected_attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775806
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Motif explicite, non vide après retrait des espaces périphériques."
    },
    "expected_projection_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "expected_published_version",
    "expected_attempt_id",
    "expected_generation",
    "idempotency_key",
    "reason",
    "expected_projection_digest"
  ],
  "additionalProperties": false
}
