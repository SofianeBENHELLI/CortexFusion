{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkTaskCommand",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "offer",
        "accept",
        "decline",
        "block",
        "resume",
        "submit",
        "request_changes",
        "complete",
        "cancel",
        "reopen"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "reason": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "assignee": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "result_summary": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "action",
    "expected_revision",
    "reason",
    "idempotency_key"
  ],
  "additionalProperties": false
}
